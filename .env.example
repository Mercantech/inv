COMPOSE_PROJECT_NAME=inv-local
NETWORK_ALIAS_PREFIX=inv-local
IMAGE_TAG=local
POSTGRES_DB=inv
POSTGRES_USER=inv
POSTGRES_PASSWORD=choose-a-long-random-password
POSTGRES_PORT=5432
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
AUTH_ISSUER=https://auth.mercantec.tech
AUTH_AUDIENCE=mercantec-apps
JWKS_URI=https://auth.mercantec.tech/.well-known/jwks.json
EQUIPMENT_MANAGER_ROLE=EquipmentManager
CORS_ORIGINS=
# Optional override; leave unset to use the Compose database and its unique alias.
# CONNECTION_STRING=Host=your-database;Port=5432;Database=inv;Username=inv;Password=your-password
