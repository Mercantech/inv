@using System.Net
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject IssueClient Issues
@inject IssueCategoryClient IssueCategories
@inject AdminAccess Admin

<section class="eq-panel" aria-label="Fejlrapporter">
    <h2>Fejlrapporter</h2>

    @if (loading)
    {
        <p role="status">Henter fejl…</p>
    }
    else if (loadError is not null)
    {
        <p role="alert">@loadError</p>
        <button type="button" class="button button-secondary" @onclick="LoadAsync">Prøv igen</button>
    }
    else
    {
        <h3>Fra seneste hardwaretest pr. board</h3>
        <p>Opdateres automatisk ved nye tests. Ikke testede komponenter tæller ikke som fejl.</p>
        @if (hardwareFaults.Count == 0)
        {
            <p>Ingen registrerede hardwarefejl i seneste tests. Se testpanelet for testdækning.</p>
        }
        else
        {
            <ul class="page-list">
                @foreach (var fault in hardwareFaults)
                {
                    <li class="page-item"><div><strong>@fault.Name · Hardwaretest</strong><p>@fault.Note</p><small>Board: @fault.SamdId · @fault.TestedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</small></div></li>
                }
            </ul>
        }
        <h3>Manuelt registrerede fejl</h3>
        @if (isAdmin)
        {
            <EditForm Model="@createModel" OnValidSubmit="CreateAsync" class="loan-form" style="margin-bottom:1rem">
                <fieldset disabled="@busy">
                    <legend>Tilføj ekstra fejl</legend>
                    <p><a href="/kategorier">Opret eller rediger egne fejlkategorier</a></p>
                    <label>
                        Kategori
                        <InputSelect TValue="Guid?" @bind-Value="createModel.IssueCategoryId">
                            <option value="">Vælg</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Beskrivelse
                        <InputTextArea @bind-Value="createModel.Description" maxlength="4000" rows="3" />
                    </label>
                    <button type="submit" class="button">Opret</button>
                </fieldset>
            </EditForm>
            @if (categories.Count == 0)
            {
                <p class="page-summary">Ingen fejlkategorier gælder dette udstyr. Opret en global kategori eller en kategori til denne udstyrstype under Kategorier.</p>
            }
        }

        @if (issues.Count == 0)
        {
            <p class="page-summary">Ingen fejlrapporter.</p>
        }
        else
        {
            <ul class="page-list">
                @foreach (var issue in issues)
                {
                    <li class="page-item" @key="issue.Id" style="align-items:flex-start;flex-direction:column">
                        <div style="display:flex;justify-content:space-between;gap:1rem;width:100%;flex-wrap:wrap">
                            <strong>@issue.CategoryName · @StatusLabel(issue.Status)</strong>
                            <small>@issue.ReportedAt.UtcDateTime.ToString("dd-MM-yyyy HH:mm") UTC</small>
                        </div>
                        <p style="margin:0;color:inherit">@issue.Description</p>
                        @if (!string.IsNullOrWhiteSpace(issue.ResolutionNote))
                        {
                            <p class="page-summary" style="margin:0">@(issue.Status == "Resolved" ? "Løsning" : "Seneste løsningsnote"): @issue.ResolutionNote</p>
                        }
                        @if (issue.ResolvedAt is DateTimeOffset resolvedAt)
                        {
                            <p class="page-summary" style="margin:0">Løst @resolvedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm") · Ansvarlig: @issue.ResolvedBySubject</p>
                        }
                        @if (isAdmin)
                        {
                            @if (editingIssueId == issue.Id)
                            {
                                <form class="loan-form" style="width:100%" @onsubmit="() => SaveResolutionAsync(issue)" @onsubmit:preventDefault>
                                    <fieldset disabled="@busy">
                                        <legend>Behandl fejlrapport</legend>
                                        <label for="@($"issue-status-{issue.Id}")">Status</label>
                                        <select id="@($"issue-status-{issue.Id}")" @bind="editStatus">
                                            <option value="Open">Åben</option>
                                            <option value="InProgress">Under behandling</option>
                                            <option value="Resolved">Løst</option>
                                        </select>
                                        <label for="@($"resolution-note-{issue.Id}")">Løsningsnote @(editStatus == "Resolved" ? "(påkrævet)" : "(valgfri)")</label>
                                        <textarea id="@($"resolution-note-{issue.Id}")" @bind="resolutionNote" @bind:event="oninput" maxlength="4000" rows="3" required="@(editStatus == "Resolved")"></textarea>
                                        @if (editError is not null) { <p role="alert">@editError</p> }
                                        <div class="page-form-actions">
                                            <button class="button" type="submit">@(busy ? "Gemmer…" : "Gem behandling")</button>
                                            <button class="button button-secondary" type="button" @onclick="CancelEdit">Annuller</button>
                                        </div>
                                    </fieldset>
                                </form>
                            }
                            else
                            {
                                <div class="page-form-actions">
                                    <button type="button" class="button" @onclick="() => StartEdit(issue)" disabled="@busy">Behandl</button>
                                    @if (issue.Status != "Resolved")
                                    {
                                        <button type="button" class="button button-secondary" @onclick='() => StartEdit(issue, "Resolved")' disabled="@busy">Løs</button>
                                    }
                                    @if (issue.Status != "Open")
                                    {
                                        <button type="button" class="button button-secondary" @onclick='() => StartEdit(issue, "Open")' disabled="@busy">@(issue.Status == "Resolved" ? "Genåbn" : "Sæt til åben")</button>
                                    }
                                    <button type="button" class="button button-danger" @onclick="() => DeleteAsync(issue)" disabled="@busy">Slet</button>
                                </div>
                            }
                        }
                    </li>
                }
            </ul>
        }
        @if (saveError is not null) { <p role="alert">@saveError</p> }
    }
</section>

@code {
    [Parameter] public Guid EquipmentId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<EquipmentIssueResponse> issues = [];
    private List<HardwareFaultResponse> hardwareFaults = [];
    private List<IssueCategoryResponse> categories = [];
    private CreateIssueFormModel createModel = new();
    private bool loading = true, busy, isAdmin;
    private string? loadError, saveError, editError;
    private Guid? editingIssueId;
    private Guid? loadedEquipmentId;
    private string editStatus = "Open", resolutionNote = "";

    protected override async Task OnParametersSetAsync()
    {
        if (loadedEquipmentId != EquipmentId) { CancelEdit(); loadedEquipmentId = EquipmentId; }
        isAdmin = await Admin.IsAdminAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            issues = await Issues.GetForEquipmentAsync(EquipmentId);
            hardwareFaults = await Issues.GetFaultDataAsync<HardwareFaultResponse>($"equipment/{EquipmentId}/hardware-faults");
            if (isAdmin)
            {
                categories = await IssueCategories.GetAllAsync(EquipmentId);
                if (!categories.Any(c => c.Id == createModel.IssueCategoryId)) createModel.IssueCategoryId = null;
            }
        }
        catch (Exception e) when (e is HttpRequestException or JSException or JsonException)
        {
            loadError = "Fejlrapporter kunne ikke hentes.";
        }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        if (busy) return;
        busy = true;
        saveError = null;
        try
        {
            var response = await Issues.CreateAsync(EquipmentId, createModel);
            if (response.Status == 201)
            {
                createModel = new();
                await LoadAsync();
                await OnChanged.InvokeAsync();
            }
            else
                saveError = response.Status switch
                {
                    403 => "Du mangler rettighed.",
                    400 => "Vælg en fejlkategori, der gælder udstyret, og udfyld beskrivelsen. Genindlæs siden, hvis kategorierne er ændret.",
                    _ => "Fejlen kunne ikke oprettes."
                };
        }
        catch (JSException) { saveError = "Tjek forbindelse og login."; }
        finally { busy = false; }
    }

    private void StartEdit(EquipmentIssueResponse issue, string? status = null)
    {
        editingIssueId = issue.Id;
        editStatus = status ?? issue.Status;
        resolutionNote = issue.ResolutionNote ?? "";
        editError = saveError = null;
    }

    private void CancelEdit()
    {
        editingIssueId = null;
        resolutionNote = "";
        editStatus = "Open";
        editError = null;
    }

    private async Task SaveResolutionAsync(EquipmentIssueResponse issue)
    {
        if (busy || editingIssueId != issue.Id) return;
        editError = saveError = null;
        var note = resolutionNote.Trim();
        if (note.Length > 4000 || (editStatus == "Resolved" && string.IsNullOrWhiteSpace(note)))
        {
            editError = "Angiv en løsningsnote på højst 4000 tegn, når fejlrapporten løses.";
            return;
        }
        busy = true;
        try
        {
            var response = await Issues.UpdateAsync(EquipmentId, issue.Id, new UpdateIssueFormModel
            {
                Status = editStatus,
                ResolutionNote = note,
                Description = issue.Description
            });
            if (response.Status == 200)
            {
                CancelEdit();
                await LoadAsync();
                await OnChanged.InvokeAsync();
            }
            else editError = response.Status switch
            {
                400 => "Kontrollér status og løsningsnote. Noten må højst være 4000 tegn og skal udfyldes ved løsning.",
                401 => "Dit login er udløbet. Log ind igen.",
                403 => "Kun equipmentmanager og admin må behandle fejlrapporter.",
                404 => "Fejlrapporten findes ikke længere. Genindlæs siden.",
                _ => "Behandlingen kunne ikke gemmes. Prøv igen."
            };
        }
        catch (Exception e) when (e is HttpRequestException or JSException or JsonException)
        { editError = "Svaret kunne ikke hentes. Kontrollér rapportens status, før du prøver igen."; }
        finally { busy = false; }
    }

    private async Task DeleteAsync(EquipmentIssueResponse issue)
    {
        if (busy) return;
        busy = true;
        saveError = null;
        try
        {
            var response = await Issues.DeleteAsync(EquipmentId, issue.Id);
            if (response.Status == 204) { await LoadAsync(); await OnChanged.InvokeAsync(); }
            else saveError = response.Status == 403 ? "Du mangler rettighed." : "Kunne ikke slette.";
        }
        catch (JSException) { saveError = "Tjek forbindelse og login."; }
        finally { busy = false; }
    }

    private static string StatusLabel(string status) => status switch
    {
        "Open" => "Åben",
        "InProgress" => "Under behandling",
        "Resolved" => "Løst",
        _ => status
    };
}
