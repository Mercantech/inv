@using Inv.Web.Models
@using Inv.Web.Services
@inject HardwareClient Hardware

<section class="hardware-section" aria-label="Hardwaretest">
    <h2>Hardwaretest</h2>
    @if (loading) { <p role="status">Henter hardwaretests…</p> }
    else if (error is not null) { <p role="alert">@error</p> }
    else if (device is null)
    {
        <p>Intet Oplà-board er tilknyttet. <a href="/hardware">Vælg et board i hardwareoversigten</a> for at se dets tests her.</p>
    }
    else
    {
        <p>Board: <code>@device.SamdId</code> · <a href="@($"/hardware/{device.SamdId}")">Se alle @device.TestCount tests</a></p>
        @if (device.LatestTest is { } report) { <TestReportView Report="report" /> }
        else { <p>Boardet har endnu ingen testrapporter.</p> }
        <p>Testresultater ændrer ikke udstyrets tilstand eller manuelle fejlrapporter.</p>
    }
</section>

@code {
    [Parameter] public Guid EquipmentId { get; set; }
    private DeviceResult? device;
    private bool loading;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        device = null;
        try { device = (await Hardware.GetDevicesAsync(EquipmentId)).SingleOrDefault(); }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or JSException)
        { error = "Hardwaretests kunne ikke hentes. Kontrollér forbindelsen og dit login."; }
        finally { loading = false; }
    }
}
