@using Inv.Web.Models

<article class="test-report">
    <header class="test-report-header">
        <div>
            <strong>@(Report.Passed ? "Bestået" : "Fejl fundet")</strong>
            <span class="test-status @(Report.Passed ? "test-pass" : "test-fail")">@Report.PassedCount bestået · @Report.FailedCount fejl</span>
        </div>
        <span>@Report.TestedAt.UtcDateTime.ToString("dd-MM-yyyy HH:mm:ss") UTC @(Report.Imported ? "· importeret" : "")</span>
    </header>
    @if (Report.HasComponentDetails)
    {
        <div class="table-scroll">
            <table class="hardware-table">
                <thead><tr><th scope="col">Komponent</th><th scope="col">Resultat</th><th scope="col">Detaljer</th></tr></thead>
                <tbody>
                    @foreach (var component in Report.Components)
                    {
                        <tr>
                            <th scope="row">@component.Name</th>
                            <td><span class="test-status @(component.Skipped ? "test-skipped" : component.Ok ? "test-pass" : "test-fail")">@(component.Skipped ? "Ikke testet" : component.Ok ? "Bestået" : "Fejl")</span></td>
                            <td class="test-note">@component.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>Denne ældre rapport har ingen læsbare komponentdetaljer. Det oprindelige resultat er bevaret.</p>
    }
</article>

@code {
    [Parameter, EditorRequired] public TestResult Report { get; set; } = null!;
}
