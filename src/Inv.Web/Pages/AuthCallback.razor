@page "/auth/callback"
@layout AuthLayout
@inject Inv.Web.Services.MercantecAuthClient Auth
@inject NavigationManager Navigation

<PageTitle>Gennemfører login · Udstyrsinventar</PageTitle>
<section class="login-card" style="max-width:28rem;margin:0 auto;grid-template-columns:1fr">
    <div class="login-action">
        <p class="eyebrow">Mercantec Auth</p>
        <h2>Gennemfører login</h2>
        <p role="status">@message</p>
        @if (failed) { <a class="button login-button" href="login">Prøv igen <span aria-hidden="true">↗</span></a> }
    </div>
</section>
@code {
    private string message = "Kontrollerer login…";
    private bool failed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { var returnUrl = await Auth.CompleteLoginAsync(); Navigation.NavigateTo(returnUrl ?? "", replace: true); }
        catch (JSException) { failed = true; message = "Login kunne ikke gennemføres. Start login igen."; StateHasChanged(); }
    }
}
