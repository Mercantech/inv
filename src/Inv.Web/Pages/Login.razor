@page "/login"
@inject Inv.Web.Services.MercantecAuthClient Auth

<PageTitle>Log ind · Udstyrsinventar</PageTitle>
<section class="page-intro">
    <h1>Log ind</h1>
    <p>Brug din Mercantec-konto for at få adgang til udstyrsregistret.</p>
    <button class="button" @onclick="LoginAsync" disabled="@busy">Log ind med Mercantec Auth</button>
    <p role="alert">@error</p>
</section>
@code {
    private bool busy;
    private string? error;
    private async Task LoginAsync()
    {
        busy = true;
        try { await Auth.LoginAsync(); }
        catch (JSException) { error = "Login kunne ikke startes. Prøv igen."; busy = false; }
    }
}
