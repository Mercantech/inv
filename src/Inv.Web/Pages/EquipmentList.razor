@page "/udstyr"
@using System.Net
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject EquipmentClient Equipment
@inject EquipmentCategoryClient Categories
@inject AdminAccess Admin
@inject IssueClient Issues

<PageTitle>Udstyr · Udstyrsinventar</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/equipment.css?v=3" />
</HeadContent>

<div class="eq-page">
    <header class="eq-hero">
        <div>
            <p class="eyebrow">Register</p>
            <h1>Udstyr</h1>
            @if (!loading && string.IsNullOrWhiteSpace(error))
            {
                <p class="eq-hero-meta">
                    @equipment.Count @(equipment.Count == 1 ? "emne" : "emner")
                    · @AvailableCount ledige
                    · @LoanedCount udlånt
                </p>
            }
        </div>
        @if (isAdmin)
        {
            <a href="/udstyr/opret" class="button">Opret udstyr</a>
        }
    </header>

    <form class="eq-toolbar eq-toolbar-equipment" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="Søgning og filtrering">
        <label for="equipment-search">
            Søg
            <input id="equipment-search"
                   type="search"
                   placeholder="ID, navn eller serienummer"
                   @bind="search"
                   @bind:event="oninput"
                   @bind:after="OnFilterChangedAsync"
                   disabled="@loading" />
        </label>

        <label for="equipment-category-filter">
            Kategori
            <InputSelect id="equipment-category-filter"
                         TValue="Guid?"
                         @bind-Value="categoryId"
                         @bind-Value:after="OnFilterChangedAsync"
                         disabled="@loading">
                <option value="">Alle</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
        </label>

        <label for="equipment-fault-count">
            Antal fejl
            <input id="equipment-fault-count" type="number" min="0" step="1" placeholder="Alle"
                   @bind="faultCount" @bind:after="OnFilterChangedAsync" disabled="@loading" />
        </label>

        <label for="equipment-loan-filter">
            Udlånsstatus
            <select id="equipment-loan-filter" @bind="loanStatus"
                    @bind:after="OnFilterChangedAsync" disabled="@loading">
                <option value="">Alle</option>
                <option value="available">Ledigt</option>
                <option value="loaned">Udlånt</option>
            </select>
        </label>

        <label for="equipment-fault-status">Fejlstatus
            <select id="equipment-fault-status" @bind="faultStatus" @bind:after="OnFilterChangedAsync" disabled="@loading">
                <option value="">Alle</option><option value="faulty">Med aktuelle fejl</option><option value="clear">Uden registrerede fejl</option>
            </select>
        </label>

        <label for="equipment-fault-filter">
            Fejlkategori (aktuelle fejl)
            <select id="equipment-fault-filter" @bind="fault" @bind:after="OnFilterChangedAsync" disabled="@loading">
                <option value="">Alle</option>
                @foreach (var group in faultCategories.GroupBy(c => c.Source))
                {
                    <optgroup label="@group.Key">
                        @foreach (var category in group)
                        {
                            <option value="@category.Key">@category.Name</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
        <div class="eq-toolbar-actions">
            <button type="submit" class="button" disabled="@loading">Søg</button>
            <button type="button" class="button button-secondary" @onclick="ResetAsync" disabled="@loading">Nulstil</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(categoryError))
    {
        <p role="status" class="eq-alert eq-alert-soft">@categoryError</p>
    }

    @if (loading)
    {
        <div class="eq-loading" role="status" aria-label="Henter udstyr">
            <div class="eq-skeleton"></div>
            <div class="eq-skeleton"></div>
            <div class="eq-skeleton"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="eq-state" role="alert">
            <strong>Kunne ikke hente udstyr</strong>
            <p>@error</p>
            <button type="button" class="button" @onclick="LoadAsync">Prøv igen</button>
        </div>
    }
    else if (equipment.Count == 0)
    {
        <div class="eq-empty" role="status">
            <strong>@(hasAppliedFilters ? "Ingen match" : "Tomt register")</strong>
            <p>
                @(hasAppliedFilters
                    ? "Prøv en anden søgning eller nulstil filtrene."
                    : "Opret det første udstyr for at komme i gang.")
            </p>
            @if (!hasAppliedFilters)
            {
                <p><a class="button" href="/udstyr/opret">Opret udstyr</a></p>
            }
        </div>
    }
    else
    {
        <p class="eq-summary" role="status">
            <strong>@equipment.Count</strong> fundet
            @if (hasAppliedFilters) { <span>· filtreret</span> }
        </p>

        <ul class="eq-list">
            @foreach (var item in equipment)
            {
                <li @key="item.Id">
                    <a class="eq-item" href="@($"/udstyr/{item.Id}")">
                        <span class="eq-id">#@item.ShortId</span>
                        <div class="eq-body">
                            <p class="eq-name">@item.Name</p>
                            <p class="eq-meta">
                                <span>@item.CategoryName</span>
                                <span>@item.SerialNumber</span>
                            </p>
                        </div>
                        <div class="eq-badges">
                            <span class="eq-chip @(item.FaultCount == 0 ? "eq-chip-loan-free" : "eq-chip-loan-out")">@item.FaultCount fejl</span>
                            <span class="eq-chip @(item.IsLoaned ? "eq-chip-loan-out" : "eq-chip-loan-free")">
                                @(item.IsLoaned ? "Udlånt" : "Ledigt")
                            </span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<EquipmentResponse> equipment = [];
    private List<EquipmentcategoryResponse> categories = [];
    private string search = string.Empty;
    private Guid? categoryId;
    private int? faultCount;
    [SupplyParameterFromQuery(Name = "categoryId")] public Guid? QueryCategoryId { get; set; }
    [SupplyParameterFromQuery(Name = "isLoaned")] public bool? QueryIsLoaned { get; set; }
    [SupplyParameterFromQuery(Name = "hasFaults")] public bool? QueryHasFaults { get; set; }
    private (Guid?, bool?, bool?)? lastQuery;
    private string faultStatus = string.Empty;
    private string loanStatus = string.Empty;
    private int loadRevision;
    private string? fault;
    private List<FaultCategoryResponse> faultCategories = [];
    private bool loading = true;
    private bool hasAppliedFilters;
    private bool isAdmin;
    private string? error;
    private string? categoryError;
    private CancellationTokenSource? filterCts;

    private int LoanedCount => equipment.Count(e => e.IsLoaned);
    private int AvailableCount => equipment.Count - LoanedCount;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await Admin.IsAdminAsync();
        try
        {
            categories = await Categories.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            categoryError = "Kategorier kunne ikke hentes — søgning på navn virker stadig.";
        }
        catch (JSException)
        {
            categoryError = "Kategorier kunne ikke hentes. Tjek login og forbindelse.";
        }
        catch (JsonException)
        {
            categoryError = "Ugyldigt kategorisvar fra API.";
        }

        try { faultCategories = await Issues.GetFaultDataAsync<FaultCategoryResponse>("fault-categories"); }
        catch (Exception e) when (e is HttpRequestException or JSException or JsonException)
        { categoryError = "Fejlkategorier kunne ikke hentes. Genindlæs siden for at prøve igen."; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = (QueryCategoryId, QueryIsLoaned, QueryHasFaults);
        if (lastQuery == query) return;
        lastQuery = query;
        filterCts?.Cancel();
        categoryId = QueryCategoryId;
        loanStatus = QueryIsLoaned switch { true => "loaned", false => "available", _ => "" };
        faultStatus = QueryHasFaults switch { true => "faulty", false => "clear", _ => "" };
        search = ""; faultCount = null; fault = null;
        await LoadAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        filterCts?.Cancel();
        filterCts = new CancellationTokenSource();
        var token = filterCts.Token;
        try
        {
            await Task.Delay(280, token);
            await LoadAsync(showSkeleton: false);
        }
        catch (TaskCanceledException) { /* ny tast */ }
    }

    private Task LoadAsync() => LoadAsync(showSkeleton: true);

    private async Task LoadAsync(bool showSkeleton)
    {
        var revision = ++loadRevision;
        if (showSkeleton) loading = true;
        error = null;

        var appliedSearch = search.Trim();
        var appliedCategoryId = categoryId;
        var appliedFaultCount = faultCount;
        bool? appliedIsLoaned = loanStatus switch { "available" => false, "loaned" => true, _ => null };
        var appliedFault = fault;
        bool? appliedHasFaults = faultStatus switch { "faulty" => true, "clear" => false, _ => null };

        try
        {
            var result = await Equipment.GetAllAsync(
                appliedSearch,
                appliedCategoryId,
                appliedFaultCount,
                appliedIsLoaned, appliedFault, appliedHasFaults);

            if (revision != loadRevision) return;
            equipment = result;

            hasAppliedFilters =
                !string.IsNullOrWhiteSpace(appliedSearch) ||
                appliedCategoryId.HasValue ||
                appliedFaultCount.HasValue ||
                appliedIsLoaned.HasValue || appliedHasFaults.HasValue || !string.IsNullOrWhiteSpace(appliedFault);
        }
        catch (HttpRequestException exception)
        {
            if (revision != loadRevision) return;
            error = exception.StatusCode switch
            {
                HttpStatusCode.BadRequest => "Ugyldige filtre.",
                HttpStatusCode.Unauthorized => "Login er udløbet. Log ind igen.",
                HttpStatusCode.Forbidden => "Du mangler rettighed til at se udstyr.",
                _ => "Udstyret kunne ikke hentes. Prøv igen."
            };
        }
        catch (JSException)
        {
            if (revision != loadRevision) return;
            error = "Forespørgslen fejlede. Tjek forbindelse og login.";
        }
        catch (JsonException)
        {
            if (revision != loadRevision) return;
            error = "Ugyldigt svar fra API.";
        }
        finally
        {
            if (revision == loadRevision) loading = false;
        }
    }

    private async Task ResetAsync()
    {
        filterCts?.Cancel();
        search = string.Empty;
        categoryId = null;
        faultCount = null;
        loanStatus = string.Empty;
        faultStatus = string.Empty;
        fault = null;
        await LoadAsync(showSkeleton: false);
    }

}
