@page "/udstyr"
@using System.Net
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject EquipmentClient Equipment
@inject EquipmentCategoryClient Categories
@inject AdminAccess Admin

<PageTitle>Udstyr · Udstyrsinventar</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/equipment.css?v=3" />
</HeadContent>

<div class="eq-page">
    <header class="eq-hero">
        <div>
            <p class="eyebrow">Register</p>
            <h1>Udstyr</h1>
            @if (!loading && string.IsNullOrWhiteSpace(error))
            {
                <p class="eq-hero-meta">
                    @equipment.Count @(equipment.Count == 1 ? "emne" : "emner")
                    · @AvailableCount ledige
                    · @LoanedCount udlånt
                </p>
            }
        </div>
        @if (isAdmin)
        {
            <a href="/udstyr/opret" class="button">Opret udstyr</a>
        }
    </header>

    <form class="eq-toolbar eq-toolbar-equipment" @onsubmit="LoadAsync" @onsubmit:preventDefault aria-label="Søgning og filtrering">
        <label for="equipment-search">
            Søg
            <input id="equipment-search"
                   type="search"
                   placeholder="ID, navn eller serienummer"
                   @bind="search"
                   @bind:event="oninput"
                   @bind:after="OnFilterChangedAsync"
                   disabled="@loading" />
        </label>

        <label for="equipment-category-filter">
            Kategori
            <InputSelect id="equipment-category-filter"
                         TValue="Guid?"
                         @bind-Value="categoryId"
                         @bind-Value:after="OnFilterChangedAsync"
                         disabled="@loading">
                <option value="">Alle</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
        </label>

        <label for="equipment-condition-filter">
            Tilstand
            <InputSelect id="equipment-condition-filter"
                         TValue="int?"
                         @bind-Value="condition"
                         @bind-Value:after="OnFilterChangedAsync"
                         disabled="@loading">
                <option value="">Alle</option>
                <option value="0">Ukendt</option>
                <option value="1">God</option>
                <option value="2">Slidt</option>
                <option value="3">Beskadiget</option>
                <option value="4">Ude af drift</option>
            </InputSelect>
        </label>

        <label for="equipment-loan-filter">
            Udlånsstatus
            <InputSelect id="equipment-loan-filter" TValue="bool?" @bind-Value="isLoaned"
                         @bind-Value:after="OnFilterChangedAsync" disabled="@loading">
                <option value="">Alle</option>
                <option value="false">Ledigt</option>
                <option value="true">Udlånt</option>
            </InputSelect>
        </label>

        <div class="eq-toolbar-actions">
            <button type="submit" class="button" disabled="@loading">Søg</button>
            <button type="button" class="button button-secondary" @onclick="ResetAsync" disabled="@loading">Nulstil</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(categoryError))
    {
        <p role="status" class="eq-alert eq-alert-soft">@categoryError</p>
    }

    @if (loading)
    {
        <div class="eq-loading" role="status" aria-label="Henter udstyr">
            <div class="eq-skeleton"></div>
            <div class="eq-skeleton"></div>
            <div class="eq-skeleton"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="eq-state" role="alert">
            <strong>Kunne ikke hente udstyr</strong>
            <p>@error</p>
            <button type="button" class="button" @onclick="LoadAsync">Prøv igen</button>
        </div>
    }
    else if (equipment.Count == 0)
    {
        <div class="eq-empty" role="status">
            <strong>@(hasAppliedFilters ? "Ingen match" : "Tomt register")</strong>
            <p>
                @(hasAppliedFilters
                    ? "Prøv en anden søgning eller nulstil filtrene."
                    : "Opret det første udstyr for at komme i gang.")
            </p>
            @if (!hasAppliedFilters)
            {
                <p><a class="button" href="/udstyr/opret">Opret udstyr</a></p>
            }
        </div>
    }
    else
    {
        <p class="eq-summary" role="status">
            <strong>@equipment.Count</strong> fundet
            @if (hasAppliedFilters) { <span>· filtreret</span> }
        </p>

        <ul class="eq-list">
            @foreach (var item in equipment)
            {
                <li @key="item.Id">
                    <a class="eq-item" href="@($"/udstyr/{item.Id}")">
                        <span class="eq-id">#@item.ShortId</span>
                        <div class="eq-body">
                            <p class="eq-name">@item.Name</p>
                            <p class="eq-meta">
                                <span>@item.CategoryName</span>
                                <span>@item.SerialNumber</span>
                            </p>
                        </div>
                        <div class="eq-badges">
                            <span class="eq-chip eq-chip-cond-@ConditionClass(item.Condition)">@GetConditionName(item.Condition)</span>
                            <span class="eq-chip @(item.IsLoaned ? "eq-chip-loan-out" : "eq-chip-loan-free")">
                                @(item.IsLoaned ? "Udlånt" : "Ledigt")
                            </span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@code {
    private List<EquipmentResponse> equipment = [];
    private List<EquipmentcategoryResponse> categories = [];
    private string search = string.Empty;
    private Guid? categoryId;
    private int? condition;
    private bool? isLoaned;
    private bool loading = true;
    private bool hasAppliedFilters;
    private bool isAdmin;
    private string? error;
    private string? categoryError;
    private CancellationTokenSource? filterCts;

    private int LoanedCount => equipment.Count(e => e.IsLoaned);
    private int AvailableCount => equipment.Count - LoanedCount;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await Admin.IsAdminAsync();
        try
        {
            categories = await Categories.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            categoryError = "Kategorier kunne ikke hentes — søgning på navn og tilstand virker stadig.";
        }
        catch (JSException)
        {
            categoryError = "Kategorier kunne ikke hentes. Tjek login og forbindelse.";
        }
        catch (JsonException)
        {
            categoryError = "Ugyldigt kategorisvar fra API.";
        }

        await LoadAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        filterCts?.Cancel();
        filterCts = new CancellationTokenSource();
        var token = filterCts.Token;
        try
        {
            await Task.Delay(280, token);
            await LoadAsync(showSkeleton: false);
        }
        catch (TaskCanceledException) { /* ny tast */ }
    }

    private Task LoadAsync() => LoadAsync(showSkeleton: true);

    private async Task LoadAsync(bool showSkeleton)
    {
        if (showSkeleton) loading = true;
        error = null;

        var appliedSearch = search.Trim();
        var appliedCategoryId = categoryId;
        var appliedCondition = condition;
        var appliedIsLoaned = isLoaned;

        try
        {
            equipment = await Equipment.GetAllAsync(
                appliedSearch,
                appliedCategoryId,
                appliedCondition,
                appliedIsLoaned);

            hasAppliedFilters =
                !string.IsNullOrWhiteSpace(appliedSearch) ||
                appliedCategoryId.HasValue ||
                appliedCondition.HasValue ||
                appliedIsLoaned.HasValue;
        }
        catch (HttpRequestException exception)
        {
            error = exception.StatusCode switch
            {
                HttpStatusCode.BadRequest => "Ugyldige filtre.",
                HttpStatusCode.Unauthorized => "Login er udløbet. Log ind igen.",
                HttpStatusCode.Forbidden => "Du mangler rettighed til at se udstyr.",
                _ => "Udstyret kunne ikke hentes. Prøv igen."
            };
        }
        catch (JSException)
        {
            error = "Forespørgslen fejlede. Tjek forbindelse og login.";
        }
        catch (JsonException)
        {
            error = "Ugyldigt svar fra API.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ResetAsync()
    {
        search = string.Empty;
        categoryId = null;
        condition = null;
        isLoaned = null;
        await LoadAsync(showSkeleton: false);
    }

    private static int ConditionClass(int condition) => condition is >= 0 and <= 4 ? condition : 0;

    private static string GetConditionName(int condition) => condition switch
    {
        0 => "Ukendt",
        1 => "God",
        2 => "Slidt",
        3 => "Beskadiget",
        4 => "Ude af drift",
        _ => "Ukendt"
    };
}
