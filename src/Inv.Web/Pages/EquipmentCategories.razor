@page "/kategorier"
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject EquipmentCategoryClient Categories

<PageTitle>Udstyrskategorier · Udstyrsinventar</PageTitle>

<header class="page-hero">
    <div>
        <p class="eyebrow">Struktur</p>
        <h1>Kategorier</h1>
        <p>Organisér udstyr efter type.</p>
    </div>
    <a class="button" href="kategorier/opret">Opret kategori</a>
</header>

@if (loading)
{
    <p role="status">Henter kategorier…</p>
}
else if (error is not null)
{
    <div class="page-state" role="alert">
        <strong>Kunne ikke hente</strong>
        <p>@error</p>
        <button class="button" @onclick="LoadAsync">Prøv igen</button>
    </div>
}
else if (categories.Count == 0)
{
    <div class="page-empty">
        <strong>Ingen kategorier</strong>
        <p>Opret den første kategori for at kunne registrere udstyr.</p>
        <p><a class="button" href="kategorier/opret">Opret kategori</a></p>
    </div>
}
else
{
    <p class="page-summary"><strong>@categories.Count</strong> kategorier</p>
    <ul class="page-list">
        @foreach (var category in categories)
        {
            <li class="page-item" @key="category.Id">
                <strong>@category.Name</strong>
            </li>
        }
    </ul>
}

@code {
    private List<EquipmentcategoryResponse> categories = [];
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try { categories = await Categories.GetAllAsync(); }
        catch (HttpRequestException exception)
        {
            error = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Login er udløbet.",
                System.Net.HttpStatusCode.Forbidden => "Du mangler adgang.",
                _ => "Kategorier kunne ikke hentes."
            };
        }
        catch (JSException) { error = "Tjek forbindelse og login."; }
        catch (JsonException) { error = "Ugyldigt API-svar."; }
        finally { loading = false; }
    }
}
