@page "/udstyr/{Id:guid}"
@using System.Net
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@using Inv.Web.Components
@inject EquipmentClient Equipment
@inject AdminAccess Admin
@inject NavigationManager Navigation

<PageTitle>@(equipment?.Name ?? "Udstyr") · Udstyrsinventar</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/equipment.css?v=2" />
</HeadContent>

<div class="eq-page">
    <a class="eq-back" href="/udstyr">← Udstyr</a>

    @if (loading)
    {
        <div class="eq-loading" role="status" aria-label="Henter udstyr">
            <div class="eq-skeleton" style="height:7rem"></div>
            <div class="eq-skeleton"></div>
            <div class="eq-skeleton"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="eq-state" role="alert">
            <strong>Kunne ikke hente udstyr</strong>
            <p>@error</p>
            <a class="button" href="/udstyr">Til oversigt</a>
        </div>
    }
    else if (equipment is null)
    {
        <div class="eq-empty" role="status">
            <strong>Ikke fundet</strong>
            <p>Udstyret findes ikke, eller du mangler adgang.</p>
            <p><a class="button" href="/udstyr">Til oversigt</a></p>
        </div>
    }
    else
    {
        <header class="eq-detail-hero">
            <span class="eq-id">#@equipment.ShortId</span>
            <div>
                <p class="eyebrow">@equipment.CategoryName</p>
                <h1>@equipment.Name</h1>
                <p class="eq-detail-sub">
                    <span>@equipment.SerialNumber</span>
                </p>
                <div class="eq-badges">
                    <span class="eq-chip eq-chip-cond-@ConditionClass(equipment.Condition)">@GetConditionName(equipment.Condition)</span>
                    <span class="eq-chip @(equipment.IsLoaned ? "eq-chip-loan-out" : "eq-chip-loan-free")">
                        @(equipment.IsLoaned ? "Udlånt" : "Ledigt")
                    </span>
                </div>
            </div>
            @if (isAdmin)
            {
                <div class="eq-detail-actions">
                    <a class="button" href="@($"/udstyr/{Id}/rediger")">Rediger</a>
                    <button type="button" class="button button-danger" @onclick="DeleteAsync" disabled="@busy">Slet</button>
                </div>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(actionError))
        {
            <p class="eq-alert" role="alert">@actionError</p>
        }

        <div class="eq-detail-grid">
            <div class="eq-stack">
                <section class="eq-panel" aria-label="Stamdata">
                    <h2>Stamdata</h2>
                    <dl class="eq-facts">
                        <dt>Kort ID</dt>
                        <dd>#@equipment.ShortId</dd>
                        <dt>Serienummer</dt>
                        <dd>@equipment.SerialNumber</dd>
                        <dt>Kategori</dt>
                        <dd>@equipment.CategoryName</dd>
                        <dt>Tilstand</dt>
                        <dd>@GetConditionName(equipment.Condition)</dd>
                        <dt>Oprettet</dt>
                        <dd>@equipment.CreatedAt.UtcDateTime.ToString("dd-MM-yyyy HH:mm") UTC</dd>
                        <dt>Ændret</dt>
                        <dd>@equipment.UpdatedAt.UtcDateTime.ToString("dd-MM-yyyy HH:mm") UTC</dd>
                    </dl>
                </section>

                <section class="eq-panel" aria-label="Udlån">
                    <h2>Udlån</h2>
                    <EquipmentLoan EquipmentId="Id" OnReturned="OnParametersSetAsync" @key="Id" />
                </section>

                <EquipmentIssues EquipmentId="Id" @key="@($"issues-{Id}")" />
            </div>

            <section class="eq-panel" aria-label="Hardwaretest">
                <h2>Hardwaretest</h2>
                <EquipmentHardware EquipmentId="Id" />
            </section>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private EquipmentResponse? equipment;
    private bool loading, isAdmin, busy;
    private string? error, actionError;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        actionError = null;
        equipment = null;
        isAdmin = await Admin.IsAdminAsync();

        try
        {
            equipment = await Equipment.GetByIdAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            error = exception.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Login er udløbet. Log ind igen.",
                HttpStatusCode.Forbidden => "Du mangler rettighed til at se udstyret.",
                _ => "Udstyret kunne ikke hentes. Prøv igen."
            };
        }
        catch (JSException)
        {
            error = "Forespørgslen fejlede. Tjek forbindelse og login.";
        }
        catch (JsonException)
        {
            error = "Ugyldigt svar fra API.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (busy || equipment is null) return;
        busy = true;
        actionError = null;
        try
        {
            var response = await Equipment.DeleteAsync(Id);
            switch (response.Status)
            {
                case 204:
                    Navigation.NavigateTo("/udstyr");
                    break;
                case 403:
                    actionError = "Du mangler rettighed.";
                    break;
                case 409:
                    actionError = TryMessage(response.Body) ?? "Udstyret kan ikke slettes i den nuværende tilstand.";
                    break;
                default:
                    actionError = "Udstyret kunne ikke slettes.";
                    break;
            }
        }
        catch (JSException)
        {
            actionError = "Sletning fejlede. Tjek forbindelse og login.";
        }
        finally { busy = false; }
    }

    private static string? TryMessage(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("Message", out var message))
                return message.GetString();
        }
        catch (JsonException) { }
        return null;
    }

    private static int ConditionClass(int condition) => condition is >= 0 and <= 4 ? condition : 0;

    private static string GetConditionName(int condition) => condition switch
    {
        0 => "Ukendt",
        1 => "God",
        2 => "Slidt",
        3 => "Beskadiget",
        4 => "Ude af drift",
        _ => "Ukendt"
    };
}
