@page "/kategorier/opret"
@using Inv.Web.Models
@using Inv.Web.Services
@inject EquipmentCategoryClient Categories
@inject AdminAccess Admin
@inject NavigationManager Navigation

<PageTitle>Opret kategori · Udstyrsinventar</PageTitle>

<a class="page-back" href="/kategorier">← Kategorier</a>

<header class="page-hero">
    <div>
        <p class="eyebrow">Struktur</p>
        <h1>Opret kategori</h1>
        <p>Fx Opladere, Skærme eller Arduino Oplà.</p>
    </div>
</header>

<EditForm Model="@model" OnValidSubmit="CreateAsync" class="page-form">
    <DataAnnotationsValidator />
    <fieldset disabled="@saving">
        <legend>Kategori</legend>
        <label for="category-name">
            Navn
            <InputText id="category-name" @bind-Value="model.Name" maxlength="150" />
        </label>
        <ValidationMessage For="@(() => model.Name)" />
        <div class="page-form-actions">
            <button type="submit" class="button">@(saving ? "Opretter…" : "Opret")</button>
            <a class="button button-secondary" href="/kategorier">Annuller</a>
        </div>
    </fieldset>
</EditForm>

@if (!string.IsNullOrEmpty(error)) { <p class="page-alert" role="alert">@error</p> }
@if (!string.IsNullOrEmpty(success)) { <p class="page-alert page-alert-ok" role="status">@success</p> }

@code {
    private CreateEquipmentCategoryModel model = new();
    private bool saving;
    private string? error;
    private string? success;

    protected override async Task OnInitializedAsync()
    {
        if (!await Admin.IsAdminAsync())
            Navigation.NavigateTo("/kategorier");
    }

    private async Task CreateAsync()
    {
        if (saving) return;
        saving = true;
        error = success = null;
        try
        {
            var response = await Categories.CreateAsync(model);
            switch (response.Status)
            {
                case 201:
                    success = $"«{model.Name.Trim()}» er oprettet.";
                    model = new();
                    break;
                case 400: error = "Angiv et navn på højst 150 tegn."; break;
                case 401: error = "Login er udløbet."; break;
                case 403: error = "Du mangler rettighed."; break;
                case 409: error = "Kategorien findes allerede."; break;
                default: error = "Kunne ikke oprette. Prøv igen."; break;
            }
        }
        catch (JSException) { error = "Tjek forbindelse og login."; }
        catch (HttpRequestException) { error = "Ingen forbindelse til API."; }
        finally { saving = false; }
    }
}
