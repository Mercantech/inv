@* Fælles formular til oprettelse og redigering af udstyr. *@

@page "/udstyr/opret"
@page "/udstyr/{Id:guid}/rediger"
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject EquipmentCategoryClient Categories
@inject EquipmentClient Equipment
@inject NavigationManager Navigation
@inject AdminAccess Admin

<PageTitle>@(IsEditing ? "Rediger udstyr" : "Opret udstyr") · Udstyrsinventar</PageTitle>

<a class="page-back" href="@(IsEditing ? $"/udstyr/{Id}" : "/udstyr")">← @(IsEditing ? "Tilbage til udstyr" : "Udstyr")</a>

<header class="page-hero">
    <div>
        <p class="eyebrow">Register</p>
        <h1>@(IsEditing ? "Rediger udstyr" : "Opret udstyr")</h1>
        <p>Angiv navn, serienummer og kategori.</p>
    </div>
</header>

@if (loading)
{
    <p role="status">Henter oplysninger…</p>
}
else if (!loaded)
{
    <div class="page-state" role="alert">
        <strong>Kunne ikke hente</strong>
        @if (!string.IsNullOrWhiteSpace(error)) { <p>@error</p> }
        <button class="button" @onclick="LoadAsync">Prøv igen</button>
    </div>
}
else if (categories.Count == 0)
{
    <div class="page-empty">
        <strong>Mangler kategori</strong>
        <p>Der skal være oprettet en kategori, før du kan gemme udstyr.</p>
        <p><a class="button" href="/kategorier/opret">Opret kategori</a></p>
    </div>
}
else
{
    <EditForm Model="@model" OnValidSubmit="SaveAsync" @key="model" class="page-form">
        <DataAnnotationsValidator />

        <fieldset disabled="@saving">
            <legend>Udstyrsoplysninger</legend>

            <label for="equipment-name">
                Navn
                <InputText id="equipment-name" @bind-Value="model.Name" maxlength="200" />
            </label>
            <ValidationMessage For="@(() => model.Name)" />

            <label for="equipment-serial-number">
                Serienummer
                <InputText id="equipment-serial-number" @bind-Value="model.SerialNumber" maxlength="200" />
            </label>
            <ValidationMessage For="@(() => model.SerialNumber)" />

            <label for="equipment-category">
                Kategori
                <InputSelect id="equipment-category" TValue="Guid?" @bind-Value="model.EquipmentCategoryId">
                    <option value="">Vælg en kategori</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
            </label>
            <ValidationMessage For="@(() => model.EquipmentCategoryId)" />


            <div class="page-form-actions">
                <button type="submit" class="button">
                    @(saving ? "Gemmer…" : IsEditing ? "Gem ændringer" : "Opret udstyr")
                </button>
                <button type="button" class="button button-secondary" @onclick="Cancel">Annuller</button>
            </div>
        </fieldset>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(error) && loaded)
{
    <p class="page-alert" role="alert">@error</p>
}

@if (validationErrors.Count > 0)
{
    <ul class="page-alert" role="alert">
        @foreach (var message in validationErrors)
        {
            <li>@message</li>
        }
    </ul>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditing => Id.HasValue;

    private static readonly JsonSerializerOptions JsonOptions =
        new(JsonSerializerDefaults.Web);

    private EquipmentFormModel model = new();
    private List<EquipmentcategoryResponse> categories = [];
    private readonly List<string> validationErrors = [];
    private bool loading = true;
    private bool loaded;
    private bool saving;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (!await Admin.IsAdminAsync())
        {
            Navigation.NavigateTo(IsEditing ? $"/udstyr/{Id}" : "/udstyr");
            return;
        }

        await LoadAsync();
    }

    private void Cancel() => Navigation.NavigateTo(IsEditing ? $"/udstyr/{Id}" : "/udstyr");

    private async Task LoadAsync()
    {
        loading = true;
        loaded = false;
        error = null;
        validationErrors.Clear();
        model = new();
        try
        {
            categories = await Categories.GetAllAsync();
            if (Id is Guid id)
            {
                var existing = await Equipment.GetByIdAsync(id);
                if (existing is null)
                {
                    error = "Udstyret blev ikke fundet.";
                    return;
                }

                model = new EquipmentFormModel
                {
                    Name = existing.Name,
                    SerialNumber = existing.SerialNumber,
                    EquipmentCategoryId = existing.EquipmentCategoryId
                };
            }
            loaded = true;
        }
        catch (HttpRequestException)
        {
            error = "Oplysningerne kunne ikke hentes. Kontrollér forbindelsen og dit login.";
        }
        catch (JSException)
        {
            error = "Forespørgslen kunne ikke gennemføres. Kontrollér forbindelsen og dit login.";
        }
        catch (JsonException)
        {
            error = "API'et returnerede ugyldige oplysninger.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        error = null;
        validationErrors.Clear();

        try
        {
            var response = Id is Guid id
                ? await Equipment.UpdateAsync(id, model)
                : await Equipment.CreateAsync(model);

            switch (response.Status)
            {
                case 200 when IsEditing:
                case 201 when !IsEditing:
                    var saved = JsonSerializer.Deserialize<EquipmentResponse>(
                        response.Body,
                        JsonOptions);

                    if (saved is null || saved.Id == Guid.Empty)
                    {
                        error = "Udstyret er gemt, men detaljesiden kunne ikke åbnes.";
                        break;
                    }

                    Navigation.NavigateTo($"/udstyr/{saved.Id}");
                    break;

                case 400:
                    ReadValidationErrors(response.Body);
                    break;

                case 401:
                    error = "Dit login er udløbet. Log ind igen.";
                    break;

                case 403:
                    error = "Du mangler rettigheden til at gemme udstyr.";
                    break;

                case 404:
                    error = "Udstyret findes ikke længere. Ændringerne blev ikke gemt.";
                    break;

                default:
                    error = "Udstyret kunne ikke gemmes. Prøv igen senere.";
                    break;
            }
        }
        catch (JSException)
        {
            error = "Forespørgslen kunne ikke gennemføres. Kontrollér forbindelsen og dit login.";
        }
        catch (HttpRequestException)
        {
            error = "Der kunne ikke oprettes forbindelse til API'et.";
        }
        catch (JsonException)
        {
            error = "API'et returnerede et ugyldigt svar. Kontrollér udstyrsoversigten, før du prøver igen.";
        }
        finally
        {
            saving = false;
        }
    }

    private void ReadValidationErrors(string body)
    {
        error = "Kontrollér de indtastede oplysninger.";

        try
        {
            using var document = JsonDocument.Parse(body);

            if (!document.RootElement.TryGetProperty("errors", out var errors) ||
                errors.ValueKind != JsonValueKind.Object)
            {
                return;
            }

            foreach (var field in errors.EnumerateObject())
            {
                if (field.Value.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                foreach (var message in field.Value.EnumerateArray())
                {
                    if (message.ValueKind == JsonValueKind.String &&
                        !string.IsNullOrWhiteSpace(message.GetString()))
                    {
                        validationErrors.Add(message.GetString()!);
                    }
                }
            }
        }
        catch (JsonException)
        {
            // Den generelle fejlbesked vises, hvis svaret ikke kan læses.
        }
    }
}
