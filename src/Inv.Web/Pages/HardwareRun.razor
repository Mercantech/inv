@page "/hardware/run"
@using System.Text.Json
@using Inv.Web.Components
@using Inv.Web.Services
@implements IAsyncDisposable
@inject WebSerialClient Serial
@inject HardwareClient Hardware
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Kør hardwaretest · Udstyrsinventar</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="css/hardware-run.css?v=1" />
</HeadContent>

<div class="hr-page">
    <header class="hr-hero">
        <div class="hr-hero-copy">
            <p class="eyebrow">Arduino Oplà</p>
            <h1>Hardwarelab</h1>
            <p>Se boardet her, mens testen kører på det fysiske Oplà. Bekræft visuelle trin, og rapporten lander automatisk i inventaret.</p>
        </div>
    </header>

    @if (!supported)
    {
        <p role="alert" class="hardware-error hr-msg">Web Serial understøttes ikke i denne browser. Brug Chrome eller Edge på en computer med USB.</p>
    }
    else
    {
        <div class="hr-stage">
            <section class="hr-board-panel" aria-label="Visuel Oplà">
                <span class="@StatusPillClass">@StatusPillLabel</span>
                @if (steps.Count > 0)
                {
                    <span class="hr-progress">@CompletedCount / @steps.Count</span>
                }

                <OplaBoardVisual ActiveStep="@ActiveStepName"
                                 Phase="@(awaitingConfirm ? "awaiting_confirm" : running ? "running" : connected ? "ready" : "idle")"
                                 Connected="connected"
                                 Running="running"
                                 AwaitingConfirm="awaitingConfirm" />

                @if (running || awaitingConfirm)
                {
                    <div class="hr-active-banner" aria-live="polite">
                        <strong>@(awaitingConfirm ? $"Bekræft: {confirmStep}" : ActiveStepName ?? "Starter…")</strong>
                        <span>@ActiveGuide</span>
                    </div>
                }
            </section>

            <aside class="hr-side">
                @if (awaitingConfirm)
                {
                    <div class="hr-guide" role="alertdialog" aria-labelledby="confirm-title">
                        <h2 id="confirm-title">Ser det rigtigt ud?</h2>
                        <p>@(confirmPrompt ?? OplaBoardVisual.StepCaption(confirmStep))</p>
                        <div class="hr-guide-actions">
                            <button class="button" @onclick='() => ReplyAsync("OK")' disabled="@busy">OK — virker</button>
                            <button class="button button-danger" @onclick='() => ReplyAsync("FAIL")' disabled="@busy">FEJL</button>
                        </div>
                    </div>
                }

                <div class="hr-card">
                    <h2>Forbindelse</h2>
                    <p>Flash firmwaren første gang, forbind boardet, og start testen.</p>
                    <div class="hr-actions">
                        @if (!awaitingBootloaderPort)
                        {
                            <button class="button" @onclick="PrepareFlashAsync" disabled="@(busy || running || flashing)">Installér firmware</button>
                        }
                        else
                        {
                            <button class="button" @onclick="CompleteFlashAsync" disabled="@busy">Vælg bootloader-port</button>
                            <button class="button button-secondary" @onclick="CancelFlashAsync" disabled="@busy">Annuller</button>
                        }
                        @if (!connected)
                        {
                            <button class="button button-secondary" @onclick="ConnectAsync" disabled="@(busy || flashing || awaitingBootloaderPort)">Forbind board</button>
                        }
                        else
                        {
                            <button class="button" @onclick="StartAsync" disabled="@(busy || running || awaitingConfirm || flashing || awaitingBootloaderPort)">Start test</button>
                            <button class="button button-secondary" @onclick="AbortAsync" disabled="@(!running && !awaitingConfirm)">Afbryd</button>
                            <button class="button button-secondary" @onclick="DisconnectAsync" disabled="@(busy || flashing || awaitingBootloaderPort)">Afbryd USB</button>
                        }
                    </div>
                    <p class="hardware-flash-hint" style="margin:.75rem 0 0;max-width:none">
                        @if (awaitingBootloaderPort)
                        {
                            <text>Boardet er i bootloader. Tryk «Vælg bootloader-port» (browseren kræver et nyt klik). Dobbelttryk Reset hvis COM mangler.</text>
                        }
                        else
                        {
                            <text>Firmware: to klik (port → bootloader-port). Opdatér firmwaren hvis WiFi-trinnet mangler.</text>
                        }
                    </p>
                    @if (flashing || flashPercent is not null || awaitingBootloaderPort)
                    {
                        <div class="hr-flash" role="status">
                            <span>Firmware @(flashPercent?.ToString() ?? "…")%@if (!string.IsNullOrEmpty(flashStatus)) { <text> — @flashStatus</text> }</span>
                            <progress max="100" value="@(flashPercent ?? 0)"></progress>
                        </div>
                    }
                </div>

                <div class="hr-card">
                    <h2>WiFi til test</h2>
                    <p>Sendes til boardet lige før start. Uden SSID springes WiFi over.</p>
                    <div class="hr-wifi-fields">
                        <label>
                            Netværk
                            <select @bind="wifiPreset" @bind:after="OnWifiPresetChanged" disabled="@(busy || running || flashing)">
                                <option value="MAGS-OLC">MAGS-OLC</option>
                                <option value="custom">Andet…</option>
                                <option value="none">Spring WiFi over</option>
                            </select>
                        </label>
                        @if (wifiPreset == "custom")
                        {
                            <label>
                                SSID
                                <input type="text" maxlength="32" @bind="wifiSsid" @bind:event="oninput" @bind:after="PersistWifiAsync"
                                       disabled="@(busy || running || flashing)" autocomplete="off" />
                            </label>
                        }
                        @if (wifiPreset != "none")
                        {
                            <label>
                                Password
                                <input type="password" maxlength="63" @bind="wifiPassword" @bind:event="oninput" @bind:after="PersistWifiAsync"
                                       disabled="@(busy || running || flashing)" autocomplete="off" />
                            </label>
                        }
                    </div>
                    @if (wifiConfiguredOnBoard is not null)
                    {
                        <p class="hr-ids" style="margin-top:.75rem" role="status">Board WiFi: <code>@wifiConfiguredOnBoard</code></p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(samdId) || steps.Count > 0)
                {
                    <div class="hr-card">
                        @if (!string.IsNullOrEmpty(samdId))
                        {
                            <h2>Board</h2>
                            <p class="hr-ids"><code>@samdId</code>@if (!string.IsNullOrEmpty(mac)) { <text> · MAC @mac</text> }</p>
                        }
                        @if (steps.Count > 0)
                        {
                            <h2 style="@(string.IsNullOrEmpty(samdId) ? null : "margin-top:1rem")">Testtrin</h2>
                            <div class="hr-steps" aria-label="Testtrin">
                                @foreach (var step in steps)
                                {
                                    <div class="hr-step @StepTileClass(step)" title="@StepLabel(step)">
                                        @ShortStepName(step.Name)
                                        <small>@StepLabel(step)</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (error is not null) { <p role="alert" class="hardware-error hr-msg">@error</p> }
                @if (message is not null) { <p role="status" class="hr-msg">@message</p> }
                @if (savedSamdId is not null)
                {
                    <p role="status" class="hr-msg">Rapport gemt. <a href="@($"/hardware/{savedSamdId}")">Se boardhistorik</a></p>
                }
            </aside>
        </div>

        <details class="hr-log">
            <summary>Serial-log</summary>
            <pre>@(log.Count == 0 ? "(tom — boardet har ikke sendt noget endnu)" : string.Join('\n', log.TakeLast(80)))</pre>
        </details>
    }
</div>

@code {
    private bool supported = true;
    private bool connected;
    private bool busy;
    private bool flashing;
    private bool awaitingBootloaderPort;
    private int? flashPercent;
    private string? flashStatus;
    private bool running;
    private bool awaitingConfirm;
    private string? confirmStep;
    private string? confirmPrompt;
    private string? samdId;
    private string? mac;
    private string? eccSerial;
    private string? error;
    private string? message;
    private string? savedSamdId;
    private string wifiPreset = "MAGS-OLC";
    private string wifiSsid = "MAGS-OLC";
    private string wifiPassword = "";
    private string? wifiConfiguredOnBoard;
    private readonly List<string> log = [];
    private readonly List<StepState> steps = [];
    private readonly List<StepState> completed = [];
    private const string WifiStorageKey = "inv.hardware.wifi";

    private sealed class StepState
    {
        public string Name { get; set; } = "";
        public string Phase { get; set; } = "begin";
        public string? Prompt { get; set; }
        public bool? Ok { get; set; }
        public bool Skipped { get; set; }
        public string? Note { get; set; }
    }

    private string? EffectiveWifiSsid => wifiPreset switch
    {
        "none" => null,
        "custom" => string.IsNullOrWhiteSpace(wifiSsid) ? null : wifiSsid.Trim(),
        _ => wifiPreset
    };

    private string? ActiveStepName =>
        awaitingConfirm ? confirmStep
        : steps.LastOrDefault(s => s.Phase is "begin" or "awaiting_confirm")?.Name
          ?? steps.LastOrDefault()?.Name;

    private string ActiveGuide =>
        awaitingConfirm
            ? (confirmPrompt ?? OplaBoardVisual.StepCaption(confirmStep))
            : OplaBoardVisual.StepCaption(ActiveStepName);

    private int CompletedCount => steps.Count(s => s.Phase == "result");

    private string StatusPillClass =>
        "hr-status-pill"
        + (awaitingConfirm ? " is-confirm" : running ? " is-running" : connected ? " is-connected" : "");

    private string StatusPillLabel =>
        awaitingConfirm ? "Bekræft" : running ? "Tester" : connected ? "Forbundet" : "Klar";

    protected override async Task OnInitializedAsync()
    {
        Serial.LineReceived += OnLine;
        Serial.ErrorReceived += OnError;
        Serial.FlashLog += OnFlashLog;
        Serial.FlashProgress += OnFlashProgress;
        supported = await Serial.IsSupportedAsync();
        if (supported)
            await Serial.WarmFlashModuleAsync();
        await LoadWifiAsync();
    }

    private async Task LoadWifiAsync()
    {
        try
        {
            var raw = await Js.InvokeAsync<string?>("sessionStorage.getItem", WifiStorageKey);
            if (string.IsNullOrWhiteSpace(raw)) return;
            using var doc = JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("preset", out var p) && p.ValueKind == JsonValueKind.String)
                wifiPreset = p.GetString() ?? wifiPreset;
            if (root.TryGetProperty("ssid", out var s) && s.ValueKind == JsonValueKind.String)
                wifiSsid = s.GetString() ?? wifiSsid;
            if (root.TryGetProperty("password", out var pw) && pw.ValueKind == JsonValueKind.String)
                wifiPassword = pw.GetString() ?? "";
            if (wifiPreset is not ("MAGS-OLC" or "custom" or "none"))
                wifiPreset = "custom";
            if (wifiPreset == "MAGS-OLC")
                wifiSsid = "MAGS-OLC";
        }
        catch (JSException) { /* ignore */ }
        catch (JsonException) { /* ignore */ }
    }

    private async Task PersistWifiAsync()
    {
        try
        {
            var payload = JsonSerializer.Serialize(new
            {
                preset = wifiPreset,
                ssid = wifiSsid,
                password = wifiPassword
            });
            await Js.InvokeVoidAsync("sessionStorage.setItem", WifiStorageKey, payload);
        }
        catch (JSException) { /* ignore */ }
    }

    private async Task OnWifiPresetChanged()
    {
        if (wifiPreset == "MAGS-OLC")
            wifiSsid = "MAGS-OLC";
        else if (wifiPreset == "none")
            wifiConfiguredOnBoard = null;
        await PersistWifiAsync();
    }

    private async Task PrepareFlashAsync()
    {
        busy = flashing = true;
        awaitingBootloaderPort = false;
        flashPercent = 0;
        flashStatus = "Starter…";
        error = message = null;
        connected = running = awaitingConfirm = false;
        log.Clear();
        try
        {
            await Serial.PrepareFlashAsync();
            awaitingBootloaderPort = true;
            flashStatus = "Klar til bootloader-port";
            message = "Tryk «Vælg bootloader-port» for at fortsætte (kræves af browseren).";
        }
        catch (JSException ex)
        {
            ApplyFlashError(ex.Message);
            await Serial.CancelFlashAsync();
        }
        catch (Exception ex)
        {
            ApplyFlashError(ex.Message);
            await Serial.CancelFlashAsync();
        }
        finally
        {
            busy = flashing = false;
        }
    }

    private async Task CompleteFlashAsync()
    {
        busy = flashing = true;
        error = message = null;
        flashPercent = 0;
        flashStatus = "Skriver firmware…";
        try
        {
            await Serial.CompleteFlashAsync();
            awaitingBootloaderPort = false;
            message = "Firmware installeret. Tryk Forbind board for at køre test.";
            flashStatus = "Færdig";
            flashPercent = 100;
        }
        catch (JSException ex)
        {
            ApplyFlashError(ex.Message);
        }
        catch (Exception ex)
        {
            ApplyFlashError(ex.Message);
        }
        finally
        {
            busy = flashing = false;
        }
    }

    private async Task CancelFlashAsync()
    {
        await Serial.CancelFlashAsync();
        awaitingBootloaderPort = false;
        flashing = false;
        flashStatus = null;
        flashPercent = null;
        message = "Firmware-installation annulleret.";
        error = null;
    }

    private void ApplyFlashError(string raw)
    {
        error = raw.Contains("Ingen port", StringComparison.OrdinalIgnoreCase)
                || raw.Contains("No port", StringComparison.OrdinalIgnoreCase)
                || raw.Contains("friskt klik", StringComparison.OrdinalIgnoreCase)
                || raw.Contains("user gesture", StringComparison.OrdinalIgnoreCase)
            ? raw
            : $"Firmware-installation fejlede: {raw}";
        flashStatus = string.IsNullOrWhiteSpace(flashStatus) || flashStatus == "Starter…"
            ? "Fejl"
            : $"Fejl — {flashStatus}";
    }

    private void OnFlashLog(string text) =>
        _ = InvokeAsync(() =>
        {
            log.Add(text);
            flashStatus = text;
            StateHasChanged();
        });

    private void OnFlashProgress(int done, int total) =>
        _ = InvokeAsync(() =>
        {
            flashPercent = total <= 0 ? 0 : (int)Math.Round(100.0 * done / total);
            StateHasChanged();
        });

    private async Task ConnectAsync()
    {
        busy = true;
        error = message = savedSamdId = null;
        samdId = mac = eccSerial = null;
        log.Clear();
        try
        {
            await Serial.ConnectAsync();
            connected = true;
            message = "Forbundet. Venter på READY fra boardet…";
            StateHasChanged();
            await Task.Delay(1500);
            if (string.IsNullOrEmpty(samdId))
            {
                try { await Serial.WriteLineAsync("STATUS"); }
                catch { /* ignore */ }
                await Task.Delay(1500);
            }
            if (string.IsNullOrEmpty(samdId))
            {
                message = "Ingen READY endnu. Flash den nye host-styrede firmware, tryk Reset på boardet, eller vælg den rigtige COM-port.";
            }
            else
            {
                message = "Boardet er klar. Tryk Start test.";
            }
        }
        catch (JSException ex)
        {
            error = ex.Message.Contains("Ingen port", StringComparison.OrdinalIgnoreCase)
                    || ex.Message.Contains("No port", StringComparison.OrdinalIgnoreCase)
                ? ex.Message
                : "Kunne ikke forbinde. Tillad USB-adgang i browseren.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task DisconnectAsync()
    {
        busy = true;
        try
        {
            await Serial.DisconnectAsync();
            connected = running = awaitingConfirm = false;
            message = "Forbindelsen er afbrudt.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task StartAsync()
    {
        error = message = savedSamdId = null;
        steps.Clear();
        completed.Clear();
        running = true;
        awaitingConfirm = false;
        try
        {
            await SendWifiConfigAsync();
            await Serial.WriteLineAsync("START");
            var ssid = EffectiveWifiSsid;
            message = string.IsNullOrEmpty(ssid)
                ? "Test startet (WiFi springes over)."
                : $"Test startet med WiFi «{ssid}».";
        }
        catch (Exception ex)
        {
            running = false;
            error = ex.Message;
        }
    }

    private async Task SendWifiConfigAsync()
    {
        var ssid = EffectiveWifiSsid ?? "";
        var password = wifiPreset == "none" ? "" : wifiPassword;
        var line = JsonSerializer.Serialize(new { v = 1, cmd = "wifi", ssid, password });
        await Serial.WriteLineAsync(line);
        wifiConfiguredOnBoard = string.IsNullOrEmpty(ssid) ? null : ssid;
        await PersistWifiAsync();
    }

    private async Task AbortAsync()
    {
        try { await Serial.WriteLineAsync("ABORT"); }
        catch (Exception ex) { error = ex.Message; }
        awaitingConfirm = false;
        message = "Afbrydelse sendt.";
    }

    private async Task ReplyAsync(string reply)
    {
        busy = true;
        try
        {
            await Serial.WriteLineAsync(reply);
            awaitingConfirm = false;
            confirmStep = confirmPrompt = null;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void OnLine(string line)
    {
        _ = InvokeAsync(async () =>
        {
            log.Add(line);
            if (line.Length == 0 || line[0] != '{') { StateHasChanged(); return; }
            try
            {
                using var doc = JsonDocument.Parse(line);
                var root = doc.RootElement;
                var type = root.TryGetProperty("type", out var t) ? t.GetString() : null;
                switch (type)
                {
                    case "ready":
                        running = false;
                        awaitingConfirm = false;
                        message ??= "Boardet er klar.";
                        break;
                    case "ids":
                        samdId = root.GetProperty("samd_id").GetString();
                        mac = root.TryGetProperty("mac", out var m) ? m.GetString() : null;
                        eccSerial = root.TryGetProperty("ecc_serial", out var e) ? e.GetString() : null;
                        await EnsureBoardRegisteredAsync();
                        break;
                    case "wifi":
                        if (root.TryGetProperty("ok", out var wifiOk) && wifiOk.ValueKind == JsonValueKind.True)
                        {
                            wifiConfiguredOnBoard = root.TryGetProperty("ssid", out var configured)
                                && configured.ValueKind == JsonValueKind.String
                                    ? configured.GetString()
                                    : EffectiveWifiSsid;
                            if (root.TryGetProperty("cleared", out var cleared) && cleared.ValueKind == JsonValueKind.True)
                                wifiConfiguredOnBoard = null;
                        }
                        break;
                    case "step":
                        HandleStep(root);
                        break;
                    case "done":
                        running = false;
                        awaitingConfirm = false;
                        await SaveReportAsync(root);
                        break;
                    case "error":
                        error = root.TryGetProperty("message", out var msg) ? msg.GetString() : "Boardfejl";
                        break;
                }
            }
            catch (JsonException)
            {
                /* ignore non-protocol JSON */
            }
            StateHasChanged();
        });
    }

    private void HandleStep(JsonElement root)
    {
        var name = root.GetProperty("name").GetString() ?? "?";
        var phase = root.GetProperty("phase").GetString() ?? "begin";
        var step = steps.LastOrDefault(s => s.Name == name);
        if (step is null || phase == "begin")
        {
            step = new StepState { Name = name };
            steps.Add(step);
        }
        step.Phase = phase;
        if (root.TryGetProperty("prompt", out var prompt) && prompt.ValueKind == JsonValueKind.String)
            step.Prompt = prompt.GetString();
        if (root.TryGetProperty("ok", out var ok) && ok.ValueKind is JsonValueKind.True or JsonValueKind.False)
            step.Ok = ok.GetBoolean();
        if (root.TryGetProperty("skipped", out var skipped) && skipped.ValueKind is JsonValueKind.True or JsonValueKind.False)
            step.Skipped = skipped.GetBoolean();
        if (root.TryGetProperty("note", out var note) && note.ValueKind == JsonValueKind.String)
            step.Note = note.GetString();

        if (phase == "awaiting_confirm")
        {
            awaitingConfirm = true;
            confirmStep = name;
            confirmPrompt = step.Prompt;
        }
        else if (phase == "result")
        {
            awaitingConfirm = false;
            confirmStep = confirmPrompt = null;
            if (!completed.Any(c => c.Name == name))
                completed.Add(step);
        }
    }

    private async Task EnsureBoardRegisteredAsync()
    {
        if (string.IsNullOrWhiteSpace(samdId)) return;
        try
        {
            await Hardware.RegisterDeviceAsync(
                samdId,
                mac,
                string.IsNullOrWhiteSpace(eccSerial) || eccSerial == "-" ? null : eccSerial,
                "Arduino Oplà");
            message = $"Board {samdId} er registreret (eller fandtes allerede).";
        }
        catch (HttpRequestException ex)
        {
            message = $"Board identificeret ({samdId}). Registrering afventer: {ex.Message}";
        }
    }

    private async Task SaveReportAsync(JsonElement done)
    {
        if (string.IsNullOrWhiteSpace(samdId))
        {
            error = "Manglende SAMD-ID — kan ikke gemme rapport.";
            return;
        }
        try
        {
            var passed = done.GetProperty("passed").GetInt32();
            var failed = done.GetProperty("failed").GetInt32();
            var tests = new List<object>();
            if (done.TryGetProperty("tests", out var arr) && arr.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in arr.EnumerateArray())
                {
                    tests.Add(new
                    {
                        name = item.GetProperty("name").GetString(),
                        ok = item.GetProperty("ok").GetBoolean(),
                        skipped = item.TryGetProperty("skipped", out var s) && s.ValueKind == JsonValueKind.True,
                        note = item.TryGetProperty("note", out var n) && n.ValueKind == JsonValueKind.String ? n.GetString() : ""
                    });
                }
            }
            if (tests.Count == 0)
            {
                error = "Rapporten indeholder ingen komponentresultater — intet gemt.";
                return;
            }
            var report = new
            {
                firmware = "HardwareTest-webserial",
                sound_enabled = false,
                samd_id = samdId,
                mac,
                ecc_serial = eccSerial,
                label = "Arduino Oplà",
                tests
            };
            await Hardware.RegisterDeviceAsync(samdId, mac, string.IsNullOrWhiteSpace(eccSerial) || eccSerial == "-" ? null : eccSerial, "Arduino Oplà");
            await Hardware.SubmitTestAsync(samdId, failed == 0, passed, failed, report);
            savedSamdId = samdId;
            message = failed == 0
                ? "Alle tests bestået — board registreret og rapport gemt."
                : "Test færdig med fejl — board registreret og rapport gemt.";
        }
        catch (HttpRequestException ex) { error = ex.Message; }
        catch (Exception ex) { error = $"Kunne ikke gemme rapport: {ex.Message}"; }
    }

    private void OnError(string message) =>
        _ = InvokeAsync(() =>
        {
            error = message;
            connected = running = awaitingConfirm = false;
            StateHasChanged();
        });

    private static string StepTileClass(StepState step) => step.Phase switch
    {
        "result" when step.Skipped => "is-skip",
        "result" when step.Ok == true => "is-pass",
        "result" => "is-fail",
        "awaiting_confirm" => "is-confirm",
        "begin" => "is-active",
        _ => "is-active"
    };

    private static string StepLabel(StepState step) => step.Phase switch
    {
        "result" when step.Skipped => "Skip",
        "result" when step.Ok == true => "OK",
        "result" => "Fejl",
        "awaiting_confirm" => "?",
        _ => "…"
    };

    private static string ShortStepName(string name) => name switch
    {
        "Temp/Fugt" => "Temp",
        "Knapper" => "Knap",
        _ => name.Length <= 6 ? name : name[..5] + "…"
    };

    public async ValueTask DisposeAsync()
    {
        Serial.LineReceived -= OnLine;
        Serial.ErrorReceived -= OnError;
        Serial.FlashLog -= OnFlashLog;
        Serial.FlashProgress -= OnFlashProgress;
        try { await Serial.DisconnectAsync(); }
        catch (JSDisconnectedException) { }
    }
}
