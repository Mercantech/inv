@page "/hardware"
@using System.Text.Json
@using Inv.Web.Models
@using Inv.Web.Services
@inject HardwareClient Hardware

<PageTitle>Hardwaretests · Udstyrsinventar</PageTitle>

<header class="page-hero">
    <div>
        <p class="eyebrow">Arduino Oplà</p>
        <h1>Hardwaretests</h1>
        <p>Seneste test, komponentfejl og historik. Knyt boards til udstyr.</p>
    </div>
    <a class="button" href="/hardware/run">Kør ny test</a>
</header>

@if (error is not null) { <p class="page-alert" role="alert">@error</p> }
@if (message is not null) { <p class="page-alert page-alert-ok" role="status">@message</p> }

@if (loading)
{
    <p role="status">Henter boards…</p>
}
else
{
    <div class="page-toolbar" role="search">
        <label>
            Søg
            <input type="search" placeholder="ID, navn, chip eller udstyr" @bind="search" @bind:event="oninput" />
        </label>
        <label class="hw-check">
            <span>Filter</span>
            <span class="hw-check-row"><input type="checkbox" @bind="onlyFailures" /> Kun fejl i seneste test</span>
        </label>
        <div class="page-toolbar-actions">
            <button class="button" type="button" @onclick="LoadAsync" disabled="@busy">Opdatér</button>
        </div>
    </div>

    <p class="page-summary">
        <strong>@Filtered.Count()</strong> af @devices.Count boards
        · @devices.Sum(device => device.TestCount) rapporter
    </p>

    @if (devices.Count == 0)
    {
        <div class="page-empty">
            <strong>Ingen boards endnu</strong>
            <p>Importér historik nedenfor, eller kør den første test.</p>
            <p><a class="button" href="/hardware/run">Kør test</a></p>
        </div>
    }
    else if (!Filtered.Any())
    {
        <div class="page-empty">
            <strong>Ingen match</strong>
            <p>Ingen boards matcher søgningen.</p>
        </div>
    }
    else
    {
        <ul class="hw-row-list">
            @foreach (var device in Filtered)
            {
                <li @key="device.SamdId">
                    <a class="hw-row" href="@($"/hardware/{device.SamdId}")">
                        <span class="hw-row-id">#@device.ShortId</span>
                        <span>
                            <strong>@(device.Label ?? "Arduino Oplà")</strong>
                            <small>@device.SamdId</small>
                        </span>
                        <span>
                            @if (device.LatestTest is { } latest)
                            {
                                <span class="test-status @(latest.Passed ? "test-pass" : "test-fail")">
                                    @(latest.Passed ? "Bestået" : "Fejl")
                                </span>
                                <small>@latest.TestedAt.UtcDateTime.ToString("dd-MM-yyyy HH:mm") UTC</small>
                            }
                            else
                            {
                                <small>Ikke testet</small>
                            }
                            @if (device.EquipmentId.HasValue)
                            {
                                <small>@device.EquipmentName</small>
                            }
                            else
                            {
                                <small>Ikke tilknyttet</small>
                            }
                        </span>
                        <span class="hw-row-meta">@device.TestCount tests</span>
                    </a>
                </li>
            }
        </ul>
    }
}

<details class="page-panel hardware-section">
    <summary>Importér eksisterende Oplà-historik</summary>
    <p>Importér et JSON-eksport fra Oplà-systemets <code>/api/devices</code>. Gentaget import springer eksisterende rapporter over.</p>
    <label>JSON-fil (maks. 10 MB)
        <InputFile OnChange="ImportFileAsync" accept=".json,application/json" disabled="@busy" />
    </label>
</details>

@code {
    private List<DeviceResult> devices = [];
    private bool loading = true;
    private bool busy;
    private string search = "";
    private bool onlyFailures;
    private string? error;
    private string? message;
    private IEnumerable<DeviceResult> Filtered => devices.Where(device =>
        (!onlyFailures || device.LatestTest is { Passed: false })
        && (string.IsNullOrWhiteSpace(search)
            || device.ShortId.ToString() == search.Trim().TrimStart('#')
            || device.EquipmentShortId?.ToString() == search.Trim().TrimStart('#')
            || device.SamdId.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || (device.Label?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
            || (device.EquipmentName?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try { devices = await Hardware.GetDevicesAsync(); }
        catch (HttpRequestException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is JsonException or JSException)
        { error = "Hardwareoversigten kunne ikke hentes. Kontrollér forbindelsen og dit login."; }
        finally { loading = false; }
    }

    private async Task ImportFileAsync(InputFileChangeEventArgs args)
    {
        busy = true;
        error = message = null;
        try
        {
            await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            using var json = await JsonDocument.ParseAsync(stream);
            if (json.RootElement.ValueKind != JsonValueKind.Array) throw new JsonException();
            var result = await Hardware.ImportAsync(json.RootElement);
            await LoadAsync();
            message = $"Import færdig: {result.DevicesAdded} nye boards, {result.ReportsAdded} nye rapporter og {result.ReportsSkipped} eksisterende rapporter sprunget over.";
        }
        catch (HttpRequestException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is JsonException or IOException or JSException)
        { error = "Filen kunne ikke importeres. Vælg et JSON-eksport fra /api/devices på højst 10 MB."; }
        finally { busy = false; }
    }
}
